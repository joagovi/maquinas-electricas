# --- Zona de entrada: material crudo, local, NO versionado -------------------
# Puede contener PDFs enormes e informes de alumnos. Lo que deba versionarse
# se mueve a mano a legacy/ despues de revisar su tamano.
_entrada/*
!_entrada/LEEME.md

# --- Salidas generadas -------------------------------------------------------
_site/
_book/
.quarto/
notebooklm/*.pdf
notebooklm/*.zip

# --- Notas internas de trabajo -----------------------------------------------
# El plan y la bitacora contienen valoraciones francas sobre el curso y sobre
# colegas. Son material de trabajo del profesor, no material de curso: no van
# al repositorio publico. Se quedan en disco y en el repositorio privado.
docs/

# --- Informacion interna: alumnos, jefes de practica, horarios ---------------
# Nombres de alumnos y de jefes de practica NO se publican en un sitio web
# abierto. El sorteo con nombres se entrega por Paideia, que exige login.
silabo/alumnos.yml
silabo/interno.yml
silabo/*.xlsx
exposiciones/sorteo.md
gestion/interno-*.qmd

# --- Material que NUNCA debe entrar a git ------------------------------------
# Informes y entregas de alumnos: viven en Drive, aqui solo se enlazan.
**/informes-alumnos/
**/entregas/
# Binarios pesados
*.mp4
*.mov
*.avi
*.mkv
*.zip
*.7z
*.tar.xz
*.iso

# --- LaTeX -------------------------------------------------------------------
# .tex intermedios que Quarto deja junto al .qmd. Las plantillas de _templates/
# SI se versionan (son fuente, no salida).
*.tex
!_templates/*.tex
*.pdf
!legacy/**/*.pdf
!silabo/**/*.pdf
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# --- Secretos ----------------------------------------------------------------
.env
.env.*
*.key
credenciales*

# --- Sistema -----------------------------------------------------------------
.DS_Store
Thumbs.db
__pycache__/
*.pyc
.venv/

/.quarto/
